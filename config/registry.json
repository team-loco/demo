{
  "distSpecVersion": "1.1.1",
  "storage": {"rootDirectory": "/var/lib/registry", "dedupe": false, "gc": true},
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "auth": {"htpasswd": {"path": "/etc/zot/htpasswd"}, "failDelay": 1},
    "accessControl": {
      "repositories": {
        "**": {
          "policies": [
            {"users": ["push"], "actions": ["read", "create", "update"]},
            {"users": ["pull"], "actions": ["read"]},
            {"users": ["api"], "actions": ["read", "delete"]}
          ],
          "defaultPolicy": []
        }
      },
      "adminPolicy": {"users": [], "actions": []}
    }
  },
  "log": {"level": "info"}
}
