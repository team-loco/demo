{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": false,
    "gc": true
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      },
      "failDelay": 1
    },
    "compat": [
      "docker2s2"
    ],
    "accessControl": {
      "repositories": {
        "team-loco/**": {
          "anonymousPolicy": [
            "read"
          ],
          "policies": [
            {
              "users": [
                "push"
              ],
              "actions": [
                "read",
                "create",
                "update"
              ]
            }
          ],
          "defaultPolicy": [
            "read"
          ]
        },
        "**": {
          "defaultPolicy": []
        }
      },
      "adminPolicy": {
        "users": [],
        "actions": []
      }
    }
  },
  "log": {
    "level": "info"
  }
}
